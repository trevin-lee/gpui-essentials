root = Stack([overview, context, visual, texts])
overview = OverviewCardBlock([o1, o2], "grid", false, @ToAssistant("Open overview"), 12)
o1 = OverviewCardItem("o1", Text("text", "Sleep", "7h 20m", "number", "lg"), MetricIndicatorInline("92", "score"))
o2 = OverviewCardItem(null, ImageText("/api/files/content?path=avatar.png", "Avatar", "Steps", "Daily", true, "vertical", 40))
context = ContextCardBlock([c1, c2], "carousel", true, {type: "continue_conversation"})
c1 = ContextCardItem("c1", "Weather", "**Sunny**, 21°", "gray")
c2 = ContextCardItem("c2", Tag("Alert", null, "sm", "warning"), "Storm later", null, "https://evil.test/bg.jpg", "Clouds")
visual = VisualCardBlock([v1, v2], "grid", true, Action([@ToAssistant("Plan a trip", "beach")]), "m")
v1 = VisualCardItem(BoldText("text", "Lisbon", "Portugal"), "lis", "/api/files/content?path=trips/lisbon.jpg", Tag("Warm"), "Lisbon at dusk")
v2 = VisualCardItem(BoldText("text", "Oslo"), "osl")
texts = Card([Stack([Text("text", "Plain"), BoldText("number", "1,000", "-5%", "metric", "xs"), ImageTextLarge("/api/files/content?path=banner.png", "Banner", "Big title", "Sub", true), MetricIndicatorWithStrikethrough("$9", null, "$12")])])
