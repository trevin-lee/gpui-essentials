root = Stack([tags, tag1, tag2, icon, ents, small, list, imgList])
tags = TagBlock(["urgent", "school", 3], "lg")
tag1 = Tag("Open", Icon("circle-check", "status"), "sm", "success")
tag2 = Tag("Plain")
icon = Icon("calendar", "time")
ents = EntityList([{left: "Rent", right: "$1,200", rightVariant: "number"}, {left: "Food", right: "$340"}], "default", {left: "Item", right: "Cost"}, {left: "Total", right: "$1,540", rightVariant: "number"})
small = EntityList([{left: "A", right: "1"}], "small", {left: "dropped", right: "header"})
list = ListBlock([ListItem("Read chapter 3", "Due Friday"), ListItem("Email the lab", null, null, "Draft it", @ToAssistant("Draft the lab email"))], "number", "small")
imgList = ListBlock([ListItem("Photo", "From the trip", {src: "/api/files/content?path=trip/1.jpg", alt: "Beach"}, null, @OpenUrl("https://example.com/album"))], "image")
