root = Stack([form, loose])
$size = "m"
form = Form("prefs", Buttons([Button("Save")]), [f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12])
f1 = FormControl("Website", Input("site", "https://", "url", {url: true}))
f2 = FormControl("Age", Input("age", "", "number", {numeric: true, min: 13, max: 120}), "Your age in years")
f3 = FormControl("Code", Input("code", "", "password"))
f4 = FormControl("Notes", TextArea("notes", "Anything else", 3, {maxLength: 200, pattern: "^[^<>]*$"}))
f5 = FormControl("Size", Select("size", [SelectItem("s", "Small"), SelectItem("m", "Medium")], "Pick one", {required: true}, $size, "small"))
f6 = FormControl("When", DatePicker("when", "range", {required: true}))
f7 = FormControl("Budget", Slider("budget", "discrete", 0, 500, 50, [100], "Dollars"))
f8 = FormControl("Topics", CheckBoxGroup("topics", [CheckBoxItem("Rust", "Systems", "rust", true), CheckBoxItem("Go", "Servers", "go")], {required: true}))
f9 = FormControl("Plan", RadioGroup("plan", [RadioItem("Free", "No cost", "free"), RadioItem("Pro", "Paid", "pro")], "free"))
f10 = FormControl("Tools", Chips("tools", "multiple", [ChipItem("figma", "Figma", Icon("figma", "design")), ChipItem("slack", "Slack", null, true), ChipItem("", "Blank")], null, ["figma"]))
f11 = FormControl("Style", OptionCards("style", "single", [OptionCard("focused", "Deep Focus", "Long blocks", Icon("target", "tools")), OptionCard("collab", "Collaborative", null, Image("Team", "/api/files/content?path=team.png"))], null, "collab"))
f12 = FormControl("Odd", Label("Not an input"))
loose = Stack([Label("Alerts"), SwitchGroup("alerts", [SwitchItem("Email", "Daily digest", "email", true), SwitchItem(null, null, "sms")], "card"), Input("q", "Search")])
